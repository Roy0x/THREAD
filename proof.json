{
  "schema_version": 1,
  "checks": [
    {
      "id": "resume_source_present",
      "type": "file_exists",
      "path": "resume.js"
    },
    {
      "id": "panel_source_present",
      "type": "file_exists",
      "path": "panel.js"
    },
    {
      "id": "panel_consumes_resolved_tab_ids",
      "type": "file_contains",
      "path": "panel.js",
      "contains": "result.resolvedTabs"
    },
    {
      "id": "panel_consumes_preferred_tab_id",
      "type": "file_contains",
      "path": "panel.js",
      "contains": "result.preferredTabId"
    },
    {
      "id": "tab_resume_acceptance",
      "type": "command",
      "argv": [
        "node",
        "--test",
        "tests/resume.proof.test.mjs"
      ],
      "timeout_seconds": 30
    }
  ]
}
