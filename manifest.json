{
  "manifest_version": 3,
  "name": "THREAD — Task Memory",
  "version": "0.3.0",
  "description": "Task checkpoints, opt-in work recovery, and local resume suggestions.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open THREAD"
  }
}
